<?xml version="1.0" encoding="utf-8"?>
<!--
  MIXEL Film MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build filmcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MIXEL Film"
      Manufacturer="MIXEL"
      Version="$(var.Version)"
      UpgradeCode="3F40932F-81D8-5FA0-9EAD-B0F9579F139F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="MIXEL Film video editor" Manufacturer="MIXEL" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MIXEL Film is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jangopeopleV2/mixel-film" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/jangopeopleV2/mixel-film" />
    <Property Id="ARPHELPLINK" Value="https://www.mixel.ch" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MIXEL Film">
        <Directory Id="LegalDir655eaad165fe602ead24" Name="Licenses">
          <Directory Id="LegalDir684a29f3fdf74fd93766" Name="epaint_default_fonts-0.36.2" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="MIXEL Film" Level="1">
      <ComponentGroupRef Id="LegalNoticesFilm" />
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="FilmcraftExe" Source="$(var.BinDir)\filmcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MIXEL Film"
              Description="MIXEL Film video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\filmcraft.exe" Value="[#FilmcraftExe]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\filmcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="LegalNoticesFilm">
      <Component Id="LegalComponent4ff1d5dc53254c402eff" Directory="LegalDir655eaad165fe602ead24">
        <File Id="LegalFile4ff1d5dc53254c402eff" Source="$(var.BinDir)\Licenses\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent1116cb222fc4ac4f9f9d" Directory="LegalDir655eaad165fe602ead24">
        <File Id="LegalFile1116cb222fc4ac4f9f9d" Source="$(var.BinDir)\Licenses\ATTRIBUTION.md" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent8236395a34f2ffc27865" Directory="LegalDir684a29f3fdf74fd93766">
        <File Id="LegalFile8236395a34f2ffc27865" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\Hack-Regular.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponentab2977cacbc754c5398f" Directory="LegalDir684a29f3fdf74fd93766">
        <File Id="LegalFileab2977cacbc754c5398f" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\OFL.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent6df37ec966048031f14b" Directory="LegalDir684a29f3fdf74fd93766">
        <File Id="LegalFile6df37ec966048031f14b" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\UFL.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent02a724cea27969d95b28" Directory="LegalDir684a29f3fdf74fd93766">
        <File Id="LegalFile02a724cea27969d95b28" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\emoji-icon-font-mit-license.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
